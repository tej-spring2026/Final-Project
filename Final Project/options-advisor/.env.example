DATA_PROVIDER=yfinance

# Flask config — generate SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_string
FLASK_DEBUG=true

# NOTE: ANTHROPIC_API_KEY is no longer set on the server.
# Users supply their own key via the login screen; it is held only in their session.
